.vscode/**
src/**
webview/src/**
scripts/**
docs/**
node_modules/**
esbuild.mjs
tsconfig.*.json
*.md
!README.md
dist/*.map
dist/extension.js
# dev-only: package-manager metadata, local state, probe junk — never ship.
# (v0.18.2 shipped 4 stray tmp-*.mjs probes and v0.18.3 three empty _tmp_* files
#  plus pnpm-lock/memory/.dsh snapshots: nothing here belongs in the extension.)
pnpm-lock.yaml
pnpm-workspace.yaml
.gitignore
.dsh/**
memory/**
# 探针/临时产物。注意 vsce 用 minimatch(dot:true) 且 * 不跨 '/'，
# 并且它「给目录模式补 /**」的逻辑会跳过含 '*' 的模式 —— 所以
# `tmp-*` 只能盖住根目录下的文件，盖不住 `tmp-x/文件`；目录形式必须
# 显式写 `/**`。0.18.2（tmp-*.mjs 探针）、0.18.4（.tmp-*.tmpdir 目录）
# 两次漏进包都是这个原因。
tmp-*
tmp-*/**
_tmp_*
_tmp_*/**
.tmp-*
.tmp-*/**
*.vsix
